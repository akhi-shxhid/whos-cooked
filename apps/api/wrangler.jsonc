{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whoscooked-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  // Non-secret settings. Secrets (COOKIE_SECRET, DODO_API_KEY, DODO_WEBHOOK_SECRET,
  // DODO_PRODUCT_PLUS) are set with `wrangler secret put`. See docs/deploy.md.
  "vars": {
    "ENVIRONMENT": "production",
    "PAYMENTS_PROVIDER": "dodo",
    "DODO_MODE": "test",
    "PUBLIC_BASE_URL": "https://whoscooked.whoscooked-api.workers.dev"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Hyperdrive config "whoscooked-db": Neon project whos-cooked (still-recipe-70179481),
      // branch main, role `hyperdrive` (data access only), direct non-pooled URL.
      "id": "3d8c73a855f74c7bb0e81d9a9088a499",
      // Local dev talks straight to Postgres. Override per machine with the env var
      // CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE (e.g. a Neon dev branch).
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/whoscooked"
    }
  ]
}
