  "dependencies": {
    "@sentry/cloudflare": "^11.10.0",
    "@whoscooked/db": "workspace:*",
    "better-auth": "^1.7.17",
    "hono": "^4.13.16",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.157.0"
  }
}
