{
  "name": "@whoscooked/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local-db node_modules/wrangler/bin/wrangler.js dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types --check && tsc --noEmit -p ."
