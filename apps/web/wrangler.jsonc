{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whoscooked",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only API calls run the Worker; everything else is served straight from the edge cache.
    "run_worker_first": ["/api/*"]
  },
  "services": [{ "binding": "API", "service": "whoscooked-api" }]
  // TODO(M0-owner): once the domain is on Cloudflare, add it here as a custom domain.
}
