---
import "@whoscooked/brand/fonts.css";
import "@whoscooked/brand/base.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** Counter-top scenery around the portrait stage on desktop. */
  scenery?: boolean;
}

const { title, description, noindex = false, scenery = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FFCF3F" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class:list={[{ scenery }]}>
    <slot />
  </body>
</html>
