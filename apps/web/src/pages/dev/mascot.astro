---
import MascotPlayground from "../../components/MascotPlayground.tsx";
import Base from "../../layouts/Base.astro";
---

<Base title="Mascot playground" description="Internal ToastMascot review tool." noindex>
  <main>
    <h1>Mascot</h1>
    <p>Internal tool for reviewing ToastMascot props. Not linked from the product.</p>
    <MascotPlayground client:load />
  </main>
</Base>

<style>
  main {
    max-width: 440px;
    margin: 0 auto;
    padding: 32px 20px 48px;
  }
</style>
