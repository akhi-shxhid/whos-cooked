---
import { ToastMascot } from "@whoscooked/brand";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Who's Cooked?" description="This page doesn't exist.">
  <main>
    <ToastMascot doneness={55} mood="shocked" lookY={0.6} size={160} title="A surprised slice of toast" />
    <h1>Nothing in this toaster</h1>
    <p>This page doesn't exist. Head back to the start.</p>
    <a href="/">Go to the start</a>
  </main>
</Base>

<style>
  main {
    max-width: 440px;
    margin: 0 auto;
    padding: 64px 20px;
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  a {
    display: inline-block;
    padding: 16px 28px;
    background: var(--plate);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
    border-radius: var(--radius-pill);
  }
</style>
