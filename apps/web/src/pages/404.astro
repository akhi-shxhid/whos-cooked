---
import { Character } from "@whoscooked/brand";
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Who's Cooked?" description="This page doesn't exist.">
  <main>
    <Character who="npc" mood="shocked" size={140} title="NPC, confused" />
    <h1>This page is cooked</h1>
    <p>It doesn't exist. Head back and play.</p>
    <a class="button button--primary" href="/">Back to the start</a>
  </main>
</Base>

<style>
  main {
    max-width: 440px;
    margin: 0 auto;
    padding: 64px 20px;
    display: grid;
    justify-items: center;
    gap: 16px;
    text-align: center;
  }

  p {
    margin: 0;
    color: var(--muted);
  }
</style>
