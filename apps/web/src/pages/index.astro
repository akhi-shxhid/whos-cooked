---
import { Character } from "@whoscooked/brand";
import Base from "../layouts/Base.astro";
---

<Base title="Who's Cooked?" description="8 microgames. 3 lives. Find out if you're locked in or cooked, then duel your friends.">
  <main class="page">
    <p class="kicker">a daily focus challenge</p>
    <h1>WHO'S<br /> COOKED?</h1>
    <p class="pitch">8 microgames. 3 lives. Are you locked in, or are you cooked?</p>

    <div class="crew" aria-hidden="true">
      <span class="c1"><Character who="doomscroll" mood="panic" size={86} title={null} /></span>
      <span class="c2"><Character who="toasty" mood="smug" size={112} title={null} /></span>
      <span class="c3"><Character who="goblin" mood="happy" size={86} title={null} /></span>
    </div>

    <a class="button button--primary play" href="/play/">Play now</a>

    <nav class="modes" aria-label="Modes">
      <a href="/play/?mode=blitz" style="--accent: var(--heat)">Blitz<span>60s, combos</span></a>
      <a href="/play/?mode=onelife" style="--accent: var(--danger)">One Life<span>one miss, out</span></a>
      <a href="/play/?mode=daily" style="--accent: var(--gold)">Daily<span>same run for all</span></a>
      <a href="/play/?mode=chill" style="--accent: var(--ice)">Chill<span>no lives</span></a>
    </nav>
  </main>
  <footer>
    <p>Who's Cooked? is a game for fun. It isn't a medical, psychological, or relationship test.</p>
    <p class="links"><a href="/play/?hub=1">Menu</a> <a href="/privacy/">Privacy</a> <a href="/terms/">Terms</a></p>
  </footer>
</Base>

<style>
  .page {
    max-width: 480px;
    margin: 0 auto;
    padding: 36px 18px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: calc(100dvh - 96px);
  }

  .kicker {
    margin: 0;
    color: var(--acid);
    font-weight: 700;
  }

  h1 {
    font-size: clamp(56px, 19vw, 96px);
    line-height: 0.86;
    letter-spacing: -0.05em;
    color: var(--paper);
  }

  .pitch {
    margin: 0;
    max-width: 30ch;
    color: var(--muted);
    font-size: 18px;
  }

  .crew {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    margin: 6px 0;
  }

  .c1 {
    rotate: -8deg;
  }

  .c3 {
    rotate: 8deg;
  }

  .play {
    font-size: 24px;
    min-height: 62px;
  }

  .modes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .modes a {
    display: grid;
    padding: 10px 12px;
    color: var(--line);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    background: var(--accent);
    border: var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow-line);
  }

  .modes a span {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 13px;
  }

  footer {
    padding: 12px 18px 24px;
    text-align: center;
    font-size: var(--text-small);
    color: var(--muted);
  }

  footer p {
    margin: 0 auto;
    max-width: 40ch;
  }

  .links {
    margin-top: 8px !important;
    display: flex;
    justify-content: center;
    gap: 16px;
  }
</style>
